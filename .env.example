# Environment — copy to backend/.env and fill in values

ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite for local dev; use postgres URL in Docker / production
DATABASE_URL=sqlite:///./data/discovery.db

VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma

# Optional for full green /health on Groq; leave empty for local Phase 1
GROQ_API_KEY=

GROQ_BASE_URL=https://api.groq.com/openai/v1

PREPROCESSING_VERSION=1.0.0
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GROQ_TRANSLATION_MODEL=llama-3.3-70b-versatile
PREPROCESS_BATCH_SIZE=256
MAX_CONTEXT_TOKENS=400

ANALYSIS_VERSION=1.0.0
GROQ_ANALYSIS_MODEL=llama-3.3-70b-versatile
LLM_RUN_COST_CEILING_USD=25
LLM_MAX_CONCURRENCY=4
ANALYZE_BATCH_SIZE=50

# Frontend (Next.js on Vercel / Netlify / local dev)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Streamlit Case 1
API_BASE_URL=http://127.0.0.1:8000
